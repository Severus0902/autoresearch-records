{
  "project": {
    "name": "idea1-qwen3-0p6b-no-memory-sft-minimal",
    "output_root": "/data/wxr/AutoResearch/idea1-memory-kgr"
  },
  "remote_safety": {
    "allowed_root": "/data/wxr",
    "allow_delete": false
  },
  "model": {
    "path": "/data/wxr/Finance/Qwen3-0.6B",
    "trust_remote_code": true
  },
  "train": {
    "sft_data": "outputs/train_data/webqsp_train500_action_sft.jsonl",
    "memory_mode": "none",
    "random_memory_top_k": 5,
    "max_train_samples": 256,
    "max_steps": 30,
    "micro_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0002,
    "max_length": 2048,
    "seed": 42,
    "save_adapter": true
  },
  "lora": {
    "enabled": true,
    "r": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "eval": {
    "subgraphs": "cache/webqsp_eval100_subgraphs.jsonl",
    "memory": "outputs/memory/webqsp_eval100_train_memory.jsonl",
    "memory_mode": "none",
    "random_memory_top_k": 5,
    "max_eval_samples": 60,
    "max_candidates": 80,
    "max_new_tokens": 32,
    "eval_before_training": true
  },
  "outputs": {
    "run_root": "runs",
    "run_name": "qwen3_0p6b_no_memory_sft_minimal"
  }
}
