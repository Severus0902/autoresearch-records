{
  "project": {
    "name": "idea1-memory-kgr-cwq",
    "output_root": "/data/wxr/AutoResearch/idea1-memory-kgr"
  },
  "remote_safety": {
    "allowed_root": "/data/wxr",
    "allow_delete": false
  },
  "dataset": {
    "name": "cwq",
    "path": "/data/wxr/PoG-main/data/cwq.json",
    "split": "pilot",
    "limit": 500
  },
  "kg": {
    "sparql_endpoint": "http://127.0.0.1:8890/sparql",
    "enabled": true,
    "timeout_sec": 30,
    "edge_limit_per_entity": 80
  },
  "subgraph": {
    "max_hops": 3,
    "max_nodes": 300,
    "max_edges": 800,
    "max_relation_candidates": 40
  },
  "memory": {
    "top_k": 5,
    "min_score": 0.05,
    "path": "outputs/memory/cwq_train_memory.jsonl"
  },
  "outputs": {
    "samples": "cache/cwq_samples.jsonl",
    "subgraphs": "cache/cwq_subgraphs.jsonl",
    "memory": "outputs/memory/cwq_train_memory.jsonl",
    "eval": "outputs/eval/cwq_selector_eval.jsonl",
    "summary": "outputs/eval/cwq_selector_summary.json"
  }
}
