{
  "project": {
    "name": "idea1-memory-kgr-webqsp",
    "output_root": "/data/wxr/autoresearch/idea1-memory-kgr"
  },
  "remote_safety": {
    "allowed_root": "/data/wxr",
    "allow_delete": false
  },
  "dataset": {
    "name": "webqsp",
    "path": "/data/wxr/Pilotenv/data/webqsp.json",
    "split": "pilot",
    "limit": 500
  },
  "kg": {
    "sparql_endpoint": "http://127.0.0.1:8890/sparql",
    "enabled": true,
    "timeout_sec": 30,
    "edge_limit_per_entity": 80
  },
  "subgraph": {
    "max_hops": 2,
    "max_nodes": 200,
    "max_edges": 500,
    "max_relation_candidates": 30
  },
  "memory": {
    "top_k": 5,
    "min_score": 0.05,
    "path": "outputs/memory/webqsp_train_memory.jsonl"
  },
  "outputs": {
    "samples": "cache/webqsp_samples.jsonl",
    "subgraphs": "cache/webqsp_subgraphs.jsonl",
    "memory": "outputs/memory/webqsp_train_memory.jsonl",
    "eval": "outputs/eval/webqsp_selector_eval.jsonl",
    "summary": "outputs/eval/webqsp_selector_summary.json"
  }
}
